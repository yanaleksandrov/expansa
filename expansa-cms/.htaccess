# BEGIN Expansa
<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    # /dashboard is a page, not the folder: no redirect to /dashboard/
    <IfModule mod_dir.c>
        DirectorySlash Off
    </IfModule>

    RewriteEngine On

    # Never serve the storage (logs, AI tasks, quarantine), the compiled views and the system files
    RewriteRule ^(storage|cache/views)/ - [F,L]
    RewriteRule ^(\.htaccess|env(\.install|\.example)?\.php|artisan|nginx\.conf)$ - [F,L]

    # Pass the Authorization header to PHP, CGI and FastCGI drop it
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # No trailing slash: pages and folders alike, the same as nginx.conf
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Only index.php runs: every other PHP file is a part of the code, the front controller answers
    RewriteRule ^(?!index\.php$).+\.php$ index.php [L]

    # Send the rest that is not a file to the front controller
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
# END Expansa
