{
    "name": "expansa-team/expansa",
    "description": "Expansa CMS",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "expansa/Yan",
            "email": "yanalexandrov@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.4",
        "ext-pdo": "*",
        "ext-fileinfo": "*",
        "ext-curl": "*",
        "ext-intl": "*",
        "ext-iconv": "*",
        "ext-openssl": "*",
        "ext-zlib": "*",
        "ext-zip": "*",
        "ext-bcmath": "*"
    },
    "require-dev": {
        "dragonmantank/cron-expression": "^3.0",
        "squizlabs/php_codesniffer": "3.*",
        "spatie/image": "^3.7",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Expansa\\": "expansa-cms/expansa/",
            "App\\": "expansa-cms/app/"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "@php scripts/sync-vendored.php"
        ],
        "post-update-cmd": [
            "@php scripts/sync-vendored.php"
        ]
    }
}
